offlineDependenciesHelpText="Python dependencies are installed from the offline wheelhouse bundled with this package. New installations use the built-in local queue and do not require Redis; Redis/Celery remains available as an optional advanced backend."
adminStepTitle="Administrator Setup"
adminDescription="Provider API keys are configured in Web Studio. A Gateway API Key can be generated automatically for external client access."
adminUsernameLabel="Administrator Username"
adminUsernameRequiredMsg="Enter an administrator username"
adminUsernameLenMsg="The username must be 2 to 64 characters"
adminPasswordLabel="Administrator Password"
adminPasswordRequiredMsg="Enter an administrator password"
adminPasswordLenMsg="The password must be 8 to 128 characters"
gatewayKeyLabel="Generate Gateway API Key Automatically"

[config]
description="Update the Web Studio port and reset the administrator username and password. Queue backend and Provider settings remain unchanged."
adminDescription="This is the administrator credential recovery entry. Saving updates the account and password, revokes old sessions, and backs up the database first."

[upgrade]
description="The upgrade preserves the current Web Studio port, queue backend, administrator credentials, and Provider configuration. Existing Redis/Celery deployments are not switched automatically."
adminDescription="The upgrade only refreshes the application and offline dependencies. It does not reset the administrator account, password, or Gateway API Key. Administrator credential recovery remains available in package settings after the upgrade."

